; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dwarmageddon"
config/description="Dwarmageddon: Dig or Die. Survivor-like 3D isometrico con trasformazione del terreno."
config/version="0.1.0"
run/main_scene="res://scenes/main/boot_intro.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120
boot_splash/bg_color=Color(0.09, 0.067, 0.051, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

GameSettings="*res://scripts/services/game_settings.gd"
UiFx="*res://scripts/ui/ui_fx.gd"
PauseMenu="*res://scenes/ui/pause_menu.tscn"
PlayerProfile="*res://scripts/services/player_profile.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"
ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=3

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg", "res://addons/debug_menu/plugin.cfg")

[gui]

theme/custom="res://resources/ui/theme.tres"

